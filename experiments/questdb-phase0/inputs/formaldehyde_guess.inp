# Step A: valence starting orbitals. SA-CASSCF(6,5) in cc-pVDZ, where the
# frontier virtuals are valence rather than diffuse.
! RHF cc-pVDZ TightSCF
%maxcore 2000
%pal nprocs 4 end
%casscf
  nel 6
  norb 5
  mult 1,3
  nroots 3,2
end
