NAME = ethylene_nevpt2_np4.inp
|  1> # Step B (timed): SA-CASSCF(2,2) + SC-NEVPT2 / aug-cc-pVTZ / RIJCOSX /
|  2> # AutoAux, orbitals projected from step A. Geometry: QUESTDB geometries/xyz/ethylene.xyz.
|  3> ! aug-cc-pVTZ RIJCOSX AutoAux TightSCF MORead
|  4> %moinp "ethylene_guess.gbw"
|  5> %maxcore 2000
|  6> %pal nprocs 4 end
|  7> %casscf
|  8>   nel 2
|  9>   norb 2
| 10>   mult 1,3
| 11>   nroots 3,1
| 12>   trafostep ri
| 13>   PTMethod SC_NEVPT2
| 14> end
