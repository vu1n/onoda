NAME = acetone_g_trah.inp
|  1> # QUESTDB acetone rows 1B2(n,3s) and 1B2(n,3pz): active (4,2,1,0), state average (A1,B2)=(1,2), (6e,7o).
|  2> # Rotations undo the energy sort ORCA applies when reading these orbitals with UseSym.
|  3> ! aug-cc-pVTZ RIJCOSX AutoAux TightSCF UseSym MORead
|  4> %moinp "acetone_c_valence_avtz_nosym.gbw"
|  5> %maxcore 2000
|  6> %pal nprocs 4 end
|  7> %scf
